set +o nohup

if (( USER_ID )); then PS1='$'; else PS1='#'; fi
PS4='[$EPOCHREALTIME] '; PS1='${|
	local e=$?

	(( e )) && REPLY+="$e|"

	return $e
}$HOSTNAME:${PWD:-?} '"$PS1 "

# Galaxy IPC Namespace Shim (Full Droidspaces Support)
[ -f /system/lib64/libipc_ns_shim.so ] && export LD_PRELOAD="/system/lib64/libipc_ns_shim.so${LD_PRELOAD:+:$LD_PRELOAD}"
